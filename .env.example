# Copy to .env for local development. Never commit .env.
# Production values belong in Render's environment settings.

# Local development uses SQLite files in ./data (created automatically).
DATABASE_URL=sqlite:///./data/mapoly_wifi.db
RADIUS_DATABASE_URL=sqlite:///./data/radius.db
REDIS_URL=redis://localhost:6379/0

# Render and the AAA VM use Supabase (PostgreSQL), because the web service, the cron jobs
# and FreeRADIUS run in separate places and cannot share a SQLite file.
# Use the connection pooler (transaction mode, port 6543) and require TLS. Example:
# DATABASE_URL=postgresql+psycopg://postgres.yllzgknifseyiazjideq:CHANGE_ME@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require
# RADIUS_DATABASE_URL=postgresql+psycopg://postgres.yllzgknifseyiazjideq:CHANGE_ME@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require

SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
PASSWORD_HASH_SCHEME=argon2

PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME

FRONTEND_ORIGIN=http://localhost:5173
LOGIN_TOKEN_TTL_SECONDS=60
DEFAULT_MAX_DEVICES=2

COA_NAS_HOST=
RADIUS_COA_SECRET=CHANGE_ME_SHARED_WITH_MIKROTIK

# TRUST_PROXY_HEADERS: true on Render only (behind its proxy). Leave false locally.
# When true, the client IP comes from the rightmost X-Forwarded-For entry.
TRUST_PROXY_HEADERS=false

# STALE_SESSION_MINUTES: open sessions with no interim update for this long are closed.
STALE_SESSION_MINUTES=15
